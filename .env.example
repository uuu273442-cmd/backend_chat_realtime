# cổng chạy server
PORT=3000

# domain frontend được phép gọi api và socket, nhiều domain cách nhau bằng dấu phẩy
URL_FE_CONNECT=http://localhost:5173

# số lớp proxy đứng trước server (render là 1)
TRUST_PROXY_HOPS=1

# mongodb
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Chat-app-realtime

# jwt
JWT_SECRET=doi_thanh_chuoi_bi_mat_dai
JWT_SECRET_REFRESH=doi_thanh_chuoi_bi_mat_khac

# cloudinary (upload tệp, ảnh, giọng nói)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# stun / turn cho cuộc gọi (chỉ dùng 1 turn server - metered)
STUN_URLS=stun:stun.relay.metered.ca:80,stun:stun.l.google.com:19302
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
